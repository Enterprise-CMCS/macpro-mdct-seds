#!/bin/bash
# This file is managed by macpro-mdct-core so if you'd like to change it let's do it there

set -eu -o pipefail

# this is the entrypoint for development. It wraps up compiling and calling run.ts
# all arguments, changes, etc. should be found in cli/run.ts

# this script checks for all the prereqs and then calls run.ts

export REGION_A=us-east-1

# Utilities
require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "$1 not found on the system. $2" >&2
        exit 1
    fi
}

# check node exists
require_cmd node "Install version in .nvmrc. If using nvm, run 'nvm use'"

# check node version
if ! diff  <(cat .nvmrc | tr -d '\n') <(node -v | tr -d '\n') > /dev/null ; then
    echo "node version does not match the version required in .nvmrc"
    echo "If using nvm, run 'nvm use'"
    exit 1
fi

# check yarn exists with corepack
corepack enable 2>/dev/null || true

# Parse arguments
UPDATE_ENV=false
LOCAL=false
ARGS=()

for arg in "$@"; do
    case $arg in
        update-env)
            UPDATE_ENV=true
        ;;
        local)
            LOCAL=true
        ;;
    esac
    ARGS+=("$arg")
done

if [ "$UPDATE_ENV" = true ]; then
    require_cmd op "Install 1Password CLI: 'brew install --cask 1password-cli'"
fi

if [ "$LOCAL" = true ]; then
    require_cmd docker "Run the workspace setup; Colima needs its container CLI"
    require_cmd colima "On macOS, install with 'brew install colima'"

    COLIMA_STATUS="$(colima status 2>&1 || true)"
    if [[ "$COLIMA_STATUS" != *"colima is running"* ]] ; then
        echo "colima installed but not running. We'll start it up for you now."
        colima start --cpu 4 --memory 10
    fi

    if ! docker --context colima info >/dev/null 2>&1 ; then
        echo "Colima's container runtime is unavailable. Start Colima and retry." >&2
        exit 1
    fi

    export PROJECT="${PROJECT:-seds}"

    MINISTACK_CONTAINER_NAME_VALUE="${MINISTACK_CONTAINER_NAME:-${PROJECT:-seds}-ministack-local}"
    MINISTACK_PORT_VALUE="${MINISTACK_PORT:-4566}"

    if [ -z "${MINISTACK_PORT:-}" ] && docker --context colima inspect "$MINISTACK_CONTAINER_NAME_VALUE" >/dev/null 2>&1 ; then
        MINISTACK_PUBLISHED_PORT="$(docker --context colima inspect -f '{{with (index .NetworkSettings.Ports "4566/tcp")}}{{(index . 0).HostPort}}{{end}}' "$MINISTACK_CONTAINER_NAME_VALUE")"
        if [ -z "$MINISTACK_PUBLISHED_PORT" ]; then
            echo "MiniStack container exists but does not publish port 4566/tcp. Set MINISTACK_PORT and retry." >&2
            exit 1
        fi
        MINISTACK_PORT_VALUE="$MINISTACK_PUBLISHED_PORT"
    fi

    if ! docker --context colima inspect "$MINISTACK_CONTAINER_NAME_VALUE" >/dev/null 2>&1 ; then
        echo "MiniStack is not running. We'll start it up for you now."
        docker --context colima run --rm -d \
            --name "$MINISTACK_CONTAINER_NAME_VALUE" \
            -p "${MINISTACK_PORT_VALUE}:4566" \
            -e LAMBDA_EXECUTOR=local \
            -e MINISTACK_HOST=localhost \
            -e S3_PERSIST=0 \
            -e RDS_PERSIST=0 \
            ministackorg/ministack:latest >/dev/null
    elif ! docker --context colima inspect -f '{{.State.Running}}' "$MINISTACK_CONTAINER_NAME_VALUE" | grep -q true ; then
        echo "MiniStack is installed but not running. We'll start it up for you now."
        docker --context colima start "$MINISTACK_CONTAINER_NAME_VALUE" >/dev/null
    fi

    export MINISTACK_PORT="$MINISTACK_PORT_VALUE"
fi

IMMUTABLE_FLAG=""
[ -n "${CI:-}" ] && IMMUTABLE_FLAG="--immutable"

yarn install $IMMUTABLE_FLAG >/dev/null 2>&1 || {
echo "Dependency install failed" >&2; exit 1; }

# run the CLI
./cli/run.ts "${ARGS[@]-}"
